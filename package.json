{
  "name": "coolapp-mui-lib",
  "version": "0.6.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/coolapp-dev/coolapp-mui-lib.git"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "react-scripts test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "release-it"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "main": "./build/index.js",
  "module": "./build/index.es.js",
  "types": "./build/index.d.ts",
  "files": [
    "build"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-url": "^8.0.2",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-controls": "^9.0.8",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.1.2",
    "@storybook/addon-onboarding": "^10.1.2",
    "@storybook/addon-themes": "^10.1.2",
    "@storybook/blocks": "^8.6.14",
    "@storybook/preset-create-react-app": "^10.1.2",
    "@storybook/react": "^10.1.2",
    "@storybook/react-webpack5": "^10.1.2",
    "@storybook/test": "^8.6.14",
    "@svgr/rollup": "^8.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-storybook": "^10.1.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-scripts": "5.0.1",
    "release-it": "^19.0.6",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.1.2",
    "typescript": "^5.9.3",
    "webpack": "^5.103.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@xstate/react": "^6.0.0",
    "xstate": "5.24.0"
  },
  "release-it": {
    "git": {
      "commit": true,
      "tag": true,
      "push": true
    },
    "github": {
      "release": true,
      "releaseName": "Release ${version}",
      "autoGenerate": true,
      "preRelease": false,
      "draft": false
    },
    "npm": {
      "skipChecks": true,
      "publish": true
    }
  }
